#include <stdio.h>
#include <stdlib.h>
int main(int argc, char** argv, char** envp) {
    int i = 0;
    char buffer[100];
    
    // Read input from user
    fgets(buffer, 100, stdin);
    
    i = 0;
    
    while (1) {
        // Calculate string length (strlen)
        int counter = -1;
        char* ptr = buffer;
        
        while (counter != 0) {
            if (*ptr == 0)
                break;
            ptr++;
            counter--;
        }
        
        int length = (-counter) - 1;
        
        if (i >= length)
            break;
        
        // Check if character is uppercase A-Z
        if (buffer[i] > 0x40 && buffer[i] <= 0x5a) {
            buffer[i] ^= 0x20;  // Convert uppercase to lowercase
        }
        
        i++;
    }
    
    // VULNERABLE: printf without format string!
    printf(buffer);  // Format string vulnerability here!
    
    exit(0);
}
