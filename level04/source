#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <sys/ptrace.h>
#include <sys/wait.h>
#include <sys/prctl.h>
#include <signal.h>


int main(int argc, char** argv, char** envp)
{
pid_t pid = fork();
char buffer[128];
memset(buffer, 0, 128);
int status = 0;
if (pid != 0)
    {
while (1)
        {
wait(&status);
if (WIFEXITED(status) || WIFSIGNALED(status))
            {
puts("child is exiting...");
break;
            }
long syscall_number = ptrace(PTRACE_PEEKUSER, pid, 44, 0);
if (syscall_number == 11)
            {
puts("no exec() for you");
kill(pid, SIGKILL);  
break;
            }
        }
    }
else
    {
prctl(PR_SET_PDEATHSIG, SIGTERM);
ptrace(PTRACE_TRACEME, 0, 0, 0);
puts("Give me some shellcode, k");
gets(buffer);
    }
return 0;
}