Level06 - Hash Collision
Vulnerability
// Anti-debug with ptrace
if (ptrace(0, 0, 1, 0) == -1) return 1;

// Custom hash validation
result = (login[3] ^ 0x1337) + 0x5eeded;
for (i = 0; i < len; i++) {
    result += (login[i] ^ result) % 0x539;
}
if (serial == result) system("/bin/sh");

Solution: GDB Bypass

gdb ./level06

# Set breakpoints at the exact addresses
(gdb) b *0x080487b5    # Before ptrace call
(gdb) b *0x08048866    # After hash calculation, before comparison

(gdb) r

# When prompted:
-> Enter Login: bonjour
-> Enter Serial: 0

# At first breakpoint (before ptrace at 0x080487b5)
# Jump past the ptrace check to address 0x080487ed (after the ptrace block)
(gdb) set $eip=0x080487ed
(gdb) c

# At second breakpoint (0x08048866 - after hash loop)
# The calculated hash is stored at ebp-0x10
(gdb) p/d *(int*)($ebp-0x10)

# You should see something like: $1 = 6232296

# Now quit and use the real serial
(gdb) q

Execute
bash./level06
Login: bonjour
Serial: 6239796
cat /home/users/level07/.pass
Flag
