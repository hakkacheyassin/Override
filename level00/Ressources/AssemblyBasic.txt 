
A. Registers
EAX, EBX, ECX, EDX  # General purpose (32-bit)
ESP                 # Stack pointer
EBP                 # Base pointer  
EIP                 # Instruction pointer (current instruction)


B. Basic Instructions:

mov eax, 5          # eax = 5
add eax, 3          # eax = eax + 3
sub eax, 1          # eax = eax - 1
push eax            # Push eax to stack
pop ebx             # Pop from stack to ebx
call func           # Call function
ret                 # Return from function

C. Stack Operations:

push ebp            # Save old base pointer
mov ebp, esp        # Set new base pointer
sub esp, 0x10       # Allocate 16 bytes on stack
leave               # Restore stack (mov esp, ebp; pop ebp)
ret                 # Return (pop eip; jmp eip)

