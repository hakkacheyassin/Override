int32_t clear_stdin(void) { 
 char i = 0; 
do { i = getchar(); 
if (i == '\n') { 
 break; } }
 while (i != 0xFF); 
return i; 
}
uint32_t get_unum(void) {
	 uint32_t result = 0; 
	 fflush(stdout); 
	 scanf("%u", &result); 
	 clear_stdin(); 
 }

 void prog_timeout(void) {
 exit(1); 
}

int32_t decrypt(uint8_t rot) {
    char buffer[17];
    
    strcpy(buffer, "Q}|u`sfg~sf{}|a3");
    int len = strlen(buffer);
    
    // XOR each character with rot
    for (int i = 0; i < len; i++) {
        buffer[i] ^= rot;  
    }
    
    // Compare with target string
    if (strncmp(buffer, "Congratulations!", 17) == 0) {
        system("/bin/sh");   WIN!
        return 0;
    } else {
        puts("\nInvalid Password");
        return 1;
    }
}

